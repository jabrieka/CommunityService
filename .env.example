# Resend API key — sign up at https://resend.com (free tier = 100 emails/day)
RESEND_API_KEY=

# The "from" address Resend will send from. Must be on a domain you've verified
# in Resend (or use the sandbox onboarding@resend.dev for testing only).
RESEND_FROM="Cosette Productions <volunteers@yourdomain.com>"

# Where admin notifications (new signups) are sent.
ADMIN_EMAIL=jabrieka1thornton@gmail.com

# OPTIONAL: Google Apps Script webhook URL for logging submissions to a Sheet.
# Leave blank to skip Sheets logging.
GOOGLE_SHEETS_WEBHOOK_URL=

# OPTIONAL: Public site URL — used to generate the QR code server-side as a
# fallback. The QR code also resolves dynamically from window.location in
# the browser, so this is mostly belt-and-suspenders.
NEXT_PUBLIC_SITE_URL=https://your-vercel-app.vercel.app
